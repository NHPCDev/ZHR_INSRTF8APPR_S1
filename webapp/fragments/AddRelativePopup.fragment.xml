<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="idAddRelativeDialog"
        title="{i18n>addImmediateRelative}"
        draggable="true"
        resizable="true"
        contentWidth="80%"
        titleAlignment="Center"
        contentHeight="50%"
    >
        <content>
            <f:SimpleForm
                id="idAddRelativeSimpleForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                columnsXL="2"
                columnsL="2"
                columnsM="2"
            >
                <core:Title id="idSmFrmTitleSelfDetails" />

                <Label
                    id="idLblPanNoSelf"
                    text="{i18n>panNoSelf}"
                    required="true"
                />
                <Input
                    id="idInpPanNoSelf"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/PanNoSelf}"
                    valueState="{viewModel>/relativePopupValidation/PanNoSelfState}"
                    valueStateText="{viewModel>/relativePopupValidation/PanNoSelfStateText}"
                />

                <Label
                    id="idLblMobileNoSelf"
                    text="{i18n>mobileNoSelf}"
                    required="true"
                />
                <Input
                    id="idInpMobileNoSelf"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/MobileNo}"
                    type="Number"
                    valueState="{viewModel>/relativePopupValidation/MobileNoState}"
                    valueStateText="{viewModel>/relativePopupValidation/MobileNoStateText}"
                />

                <Label
                    id="idLblEmailIdSelf"
                    text="{i18n>emailIdSelf}"
                    required="true"
                />
                <Input
                    id="idInpEmailIdSelf"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/EmailIdSelf}"
                    type="Email"
                    valueState="{viewModel>/relativePopupValidation/EmailIdSelfState}"
                    valueStateText="{viewModel>/relativePopupValidation/EmailIdSelfStateText}"
                />

                <Label
                    id="idLblMaritalStatus"
                    text="{i18n>maritalStatus}"
                    required="true"
                />
                <ComboBox
                    id="idSelMaritalStatus"
                    selectedKey="{viewModel>/RelativePopup/MaritalStatus}"
                    items="{path:'/ZHR_CDS_IT_MARITIALSTATUS_F4H'}"
                    valueState="{viewModel>/relativePopupValidation/MaritalStatusState}"
                    valueStateText="{viewModel>/relativePopupValidation/MaritalStatusStateText}"
                    change="onComboBoxChange"
                >
                    <core:Item
                        id="idItmMarried"
                        key="{StatusCode}"
                        text="{Statustext}"
                    />
                </ComboBox>

                <Label
                    id="idLblImmediateRelativeName"
                    text="{i18n>nameOfImmediateRelative}"
                    required="true"
                />
                <ComboBox
                    id="idInpImmediateRelativeName"
                    selectedKey="{viewModel>/RelativePopup/NameOfImmediateRelatives}"
                    selectionChange="onImmediateRelativeChange"
                    change="onComboBoxChangeRelative"
                    items="{
                        path:'/RelativeNamesF4Set'
                    }"
                    valueState="{viewModel>/relativePopupValidation/NameOfImmediateRelativesState}"
                    valueStateText="{viewModel>/relativePopupValidation/NameOfImmediateRelativesStateText}"
                >
                    <core:Item
                        id="idItmRelativeName"
                        key="{RelativeName}"
                        text="{RelativeName}"
                    />
                </ComboBox>
                <Label
                    id="idLblRelationImmediateRelative"
                    text="{i18n>relationOfImmediateRelative}"
                    required="{viewModel>/relativePopupUI/RelationOfImmediateRelativeEditable}"
                />
                <Input
                    id="idInpRelationImmediateRelative"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/RelationOfImmediateRelative}"
                    editable="false"
                    valueState="{viewModel>/relativePopupValidation/RelationOfImmediateRelativeState}"
                    valueStateText="{viewModel>/relativePopupValidation/RelationOfImmediateRelativeStateText}"
                />

                <Label
                    id="idLblOthers"
                    text="{i18n>others}"
                    required="{viewModel>/relativePopupUI/OthersEditable}"
                />
                <Input
                    id="idInpOthers"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/Others}"
                    editable="{viewModel>/relativePopupUI/OthersEditable}"
                    valueState="{viewModel>/relativePopupValidation/OthersState}"
                    valueStateText="{viewModel>/relativePopupValidation/OthersStateText}"
                />
                <Label
                    id="idLblRelation"
                    text="{i18n>relationship}"
                />
                <Input
                    id="idInpRelation"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/Relation}"
                    editable="{viewModel>/relativePopupUI/RelationOfImmediateRelativeEditable}"
                    valueState="{viewModel>/relativePopupValidation/RelationState}"
                    valueStateText="{viewModel>/relativePopupValidation/RelationStateText}"
                />

                <core:Title
                    id="idSmFrmTitleDetails"
                    text=""
                />

                <Label
                    id="idLblPhoneRelative"
                    text="{i18n>phoneNoImmediateRelative}"
                    required="{viewModel>/relativePopupUI/PhoneNoOfImmediateRelativeEditable}"
                />
                <Input
                    id="idInpPhoneRelative"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/PhoneNoOfImmediateRelative}"
                    editable="{viewModel>/relativePopupUI/PhoneNoOfImmediateRelativeEditable}"
                    valueState="{viewModel>/relativePopupValidation/PhoneNoOfImmediateRelativeState}"
                    valueStateText="{viewModel>/relativePopupValidation/PhoneNoOfImmediateRelativeStateText}"
                />

                <Label
                    id="idLblPanRelative"
                    text="{i18n>panOfImmediateRelative}"
                    required="{viewModel>/relativePopupUI/PanOfImmediateRelativeEditable}"
                />
                <Input
                    id="idInpPanRelative"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/PanOfImmediateRelative}"
                    editable="{viewModel>/relativePopupUI/PanOfImmediateRelativeEditable}"
                    valueState="{viewModel>/relativePopupValidation/PanOfImmediateRelativeState}"
                    valueStateText="{viewModel>/relativePopupValidation/PanOfImmediateRelativeStateText}"
                />

                <Label
                    id="idLblMatFinGuide"
                    text="{i18n>materialFinGuide}"
                    required="true"
                />
                <!-- <Input id="idInpMatFinGuide" value="{viewModel>/RelativePopup/MaterialFinancialRelationship}" /> -->
                <ComboBox
                    id="idInpMatFinGuide"
                    selectedKey="{viewModel>/RelativePopup/MaterialFinancialRelationship}"
                    selectionChange="onMaterialFinancialGuideChange"
                    change="onComboBoxChangeFin"
                    items="{
                        path:'/ZHR_CDS_IT_TRADEPERFORM_F4H'
                    }"
                    valueState="{viewModel>/relativePopupValidation/MaterialFinancialRelationshipState}"
                    valueStateText="{viewModel>/relativePopupValidation/MaterialFinancialRelationshipStateText}"
                >
                    <core:Item
                        id="idItmMatFInRel"
                        key="{StatusCode}"
                        text="{Statustext}"
                    />
                </ComboBox>

                <Label
                    id="idLblFinancialGuide"
                    text="{i18n>nameOfFinancialGuide}"
                    required="{viewModel>/relativePopupUI/FinancialGuideEditable}"
                />
                <Input
                    id="idInpFinancialGuide"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/NameOfFinancialGuide}"
                    editable="{viewModel>/relativePopupUI/FinancialGuideEditable}"
                    valueState="{viewModel>/relativePopupValidation/NameOfFinancialGuideState}"
                    valueStateText="{viewModel>/relativePopupValidation/NameOfFinancialGuideStateText}"
                />

                <Label
                    id="idLblFinancialGuidePhone"
                    text="{i18n>phoneNoFinancialGuide}"
                    required="{viewModel>/relativePopupUI/FinancialGuideEditable}"
                />
                <Input
                    id="idInpFinancialGuidePhone"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/PhoneNoOfFinancialGuide}"
                    editable="{viewModel>/relativePopupUI/FinancialGuideEditable}"
                    valueState="{viewModel>/relativePopupValidation/PhoneNoOfFinancialGuideState}"
                    valueStateText="{viewModel>/relativePopupValidation/PhoneNoOfFinancialGuideStateText}"
                />

                <Label
                    id="idLblFinancialGuidePan"
                    text="{i18n>panOfFinancialGuide}"
                    required="{viewModel>/relativePopupUI/FinancialGuideEditable}"
                />
                <Input
                    id="idInpFinancialGuidePan"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/PanOfOfFinancialGuide}"
                    editable="{viewModel>/relativePopupUI/FinancialGuideEditable}"
                    valueState="{viewModel>/relativePopupValidation/PanOfOfFinancialGuideState}"
                    valueStateText="{viewModel>/relativePopupValidation/PanOfOfFinancialGuideStateText}"
                />

                <Label
                    id="idLblNoOfSecurities"
                    text="{i18n>noOfSecuritiesHeld}"
                    required="true"
                />
                <Input
                    id="idInpNoOfSecurities"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/NoOfSecuritiesheld}"
                    valueState="{viewModel>/relativePopupValidation/NoOfSecuritiesheldState}"
                    valueStateText="{viewModel>/relativePopupValidation/NoOfSecuritiesheldStateText}"
                />

                <Label
                    id="idLblDpClientId"
                    text="{i18n>dpClientId}"
                    required="true"
                />
                <Input
                    id="idInpDpClientId"
                    change="onInputChange"
                    value="{viewModel>/RelativePopup/DPClientID}"
                    valueState="{viewModel>/relativePopupValidation/DPClientIDState}"
                    valueStateText="{viewModel>/relativePopupValidation/DPClientIDStateText}"
                />
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button
                id="idBtnRelativeSubmit"
                text="{i18n>submitBtnTxt}"
                type="Emphasized"
                press="onRelativePopupSubmit"
            />
        </beginButton>

        <endButton>
            <Button
                id="idBtnRelativeClose"
                text="{i18n>closeBtnTxt}"
                press="onRelativePopupClose"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
