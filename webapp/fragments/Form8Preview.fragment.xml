<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="idPreviewDialog"
        title="{i18n>previewDialogTitle}"
        contentWidth="100%"
        contentHeight="100%"
        draggable="true"
        resizable="true"
        horizontalScrolling="false"
    >
        <content>
            <ScrollContainer
                id="idPreviewScrollContainer"
                vertical="true"
                horizontal="true"
                height="100%"
            >
                <VBox
                    id="idPreviewMainVBox"
                    width="96%"
                    class="sapUiMediumMargin"
                >
                    <!-- Header Text -->

                    <VBox
                        id="idPreviewHeaderVBox"
                        alignItems="Center"
                        class="sapUiMediumMarginBottom"
                    >
                        <Title
                            id="idPreviewFormTitle"
                            text="{viewModel>/FormTitle}"
                            level="H1"
                            class="formHeading"
                        />

                        <Title
                            id="idPreviewSubTitle"
                            text="{viewModel>/SubTitle}"
                            level="H4"
                            wrapping="true"
                            class="sapUiTinyMarginTop formSubHeading"
                        />
                    </VBox>

                    <Text
                        id="idPreviewIntroText"
                        text="{viewModel>/HeaderTexts}"
                        wrapping="true"
                        class="sapUiSmallMarginBottom"
                    />

                    <VBox
                        id="idPreviewEmployeeForm"
                        class="sapUiMediumMarginBottom"
                    >
                        <HBox
                            id="idHBoxPreviewNameDesignation"
                            class="sapUiTinyMarginBottom"
                        >
                            <Text
                                id="idLblPreviewNameDesignation"
                                text="{i18n>previewNameDesignation}"
                                width="17rem"
                                class="previewLabelText"
                            />
                            <Text
                                id="idTxtPreviewNameDesignation"
                                text="{viewModel>/EmpDetails/ENAME}"
                            />
                        </HBox>

                        <HBox
                            id="idHBoxPreviewEmployeeNumber"
                            class="sapUiTinyMarginBottom"
                        >
                            <Text
                                id="idLblPreviewEmployeeNumber"
                                text="{i18n>previewEmployeeNumber}"
                                width="17rem"
                                class="previewLabelText"
                            />
                            <Text
                                id="idTxtPreviewEmployeeNumber"
                                text="{viewModel>/EmpDetails/PERNR}"
                            />
                        </HBox>

                        <HBox
                            id="idHBoxPreviewDesignation"
                            class="sapUiTinyMarginBottom"
                        >
                            <Text
                                id="idLblPreviewDesignation"
                                text="{i18n>previewDesignation}"
                                width="17rem"
                                class="previewLabelText"
                            />
                            <Text
                                id="idTxtPreviewDesignation"
                                text="{viewModel>/Header/Designation}"
                            />
                        </HBox>

                        <HBox
                            id="idHBoxPreviewDepartment"
                            class="sapUiTinyMarginBottom"
                        >
                            <Text
                                id="idLblPreviewDepartment"
                                text="{i18n>previewDepartment}"
                                width="17rem"
                                class="previewLabelText"
                            />
                            <Text
                                id="idTxtPreviewDepartment"
                                text="{viewModel>/Header/Department}"
                            />
                        </HBox>

                        <HBox
                            id="idHBoxPreviewDesignationDate"
                            class="sapUiTinyMarginBottom"
                        >
                            <Text
                                id="idLblPreviewDesignationDate"
                                text="{i18n>previewDesignationDate}"
                                width="17rem"
                                class="previewLabelText"
                            />
                            <Text
                                id="idTxtPreviewDesignationDate"
                                text="{
                                    path:'viewModel>/Header/DateOfJoiningDP',
                                    formatter: '.formatter.formatDate'
                                }"
                            />
                        </HBox>
                    </VBox>

                    <!-- Self Details -->

                    <Title
                        id="idTitlePreviewSelf"
                        text="{i18n>previewSelfSection}"
                        level="H4"
                        class="sapUiMediumMarginTop sapUiSmallMarginBottom"
                    />

                    <Table
                        id="idTablePreviewSelf"
                        items="{viewModel>/SelfDetails}"
                    >
                        <columns>
                            <Column id="idColPreviewSelfSerial">
                                <Text
                                    id="idTxtPreviewSelfSerial"
                                    text="{i18n>previewSerialNumber}"
                                />
                            </Column>

                            <Column id="idColPreviewSelfSecurity">
                                <Text
                                    id="idTxtPreviewSelfSecurity"
                                    text="{i18n>previewNoOfSecurities}"
                                />
                            </Column>

                            <Column id="idColPreviewSelfDpId">
                                <Text
                                    id="idTxtPreviewSelfDpId"
                                    text="{i18n>previewDpClientId}"
                                />
                            </Column>

                            <Column id="idColHdrDtlComp5SelfPRV">
                                <Text
                                    id="idColHdrTxtDtlComp5SelfPRV"
                                    text="{i18n>Natureofsecurity}"
                                />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="idCliPreviewSelf">
                                <cells>
                                    <Text
                                        id="idTxtPreviewSelfNo"
                                        text="{viewModel>SelfNo}"
                                    />

                                    <Text
                                        id="idTxtPreviewSelfSecurities"
                                        text="{viewModel>NoOfSecuritiesheld}"
                                    />

                                    <Text
                                        id="idTxtPreviewSelfDPClient"
                                        text="{viewModel>DPClientID}"
                                    />
                                    <Text
                                        id="idTxtPreviewSelfDPClientPRV"
                                        text="{viewModel>Natureofsecurity}"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                    <!-- Relative Details -->

                    <Title
                        id="idTitlePreviewRelative"
                        text="{i18n>previewRelativeSection}"
                        level="H4"
                        class="sapUiMediumMarginTop sapUiSmallMarginBottom"
                    />

                    <Table
                        id="idTablePreviewRelative"
                        items="{viewModel>/RelativeDetails}"
                    >
                        <columns>
                            <Column id="idColPreviewRelativeSerial">
                                <Text
                                    id="idTxtPreviewRelativeSerial"
                                    text="{i18n>previewSerialNumber}"
                                />
                            </Column>

                            <Column id="idColPreviewRelativeDpId">
                                <Text
                                    id="idTxtPreviewRelativeDpId"
                                    text="{i18n>previewDpClientId}"
                                />
                            </Column>
                            <Column id="idColPreviewNoOfSecurities">
                                <Text
                                    id="idTxtPreviewNoOfSecurities"
                                    text="{i18n>previewNoOfSecurities}"
                                />
                            </Column>

                            <Column id="idColPreviewRelativeName">
                                <Text
                                    id="idTxtPreviewRelativeName"
                                    text="{i18n>previewImmediateRelative}"
                                />
                            </Column>

                            <Column id="idColPreviewRelativeRelation">
                                <Text
                                    id="idTxtPreviewRelativeRelation"
                                    text="{i18n>relationOfImmediateRelative}"
                                />
                            </Column>
                            <Column id="idColPreviewRelativeRelationPRV">
                                <Text
                                    id="idTxtPreviewRelativeRelationPRV"
                                    text="{i18n>Natureofsecurity}"
                                />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="idCliPreviewRelative">
                                <cells>
                                    <Text
                                        id="idTxtPreviewRelativeNo"
                                        text="{viewModel>SlNo}"
                                    />
                                    <Text
                                        id="idTxtPreviewRelativeDPClient"
                                        text="{viewModel>DPClientID}"
                                    />
                                    <Text
                                        id="idTxtPreviewRelativeNoOfSecurities"
                                        text="{viewModel>NoOfSecuritiesheld}"
                                    />
                                    <Text
                                        id="idTxtPreviewRelativeImmediateName"
                                        text="{viewModel>NameOfImmediateRelatives}"
                                    />

                                    <Text
                                        id="idTxtPreviewRelativeRelationship"
                                        text="{viewModel>RelationOfImmediateRelative}"
                                    />
                                    <Text
                                        id="idTxtPreviewRelativeRelationshipPRV"
                                        text="{viewModel>Natureofsecurity}"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                    <!-- Undertaking -->

                    <Title
                        id="idTitlePreviewDisclosure"
                        text="{i18n>previewOtherDisclosure}"
                        level="H4"
                        class="sapUiMediumMarginTop"
                    />

                    <FormattedText
                        id="idPreviewUndertakingText"
                        class="sapUiSmallMarginTop"
                        htmlText="{
                            path:'viewModel>/Header/UndertakingText',
                            formatter:'.formatter.formatUndertakingText'
                        }"
                    />
                </VBox>
            </ScrollContainer>
        </content>

        <endButton>
            <Button
                id="idBtnPreviewClose"
                text="{i18n>closeBtnTxt}"
                press="onPreviewClose"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
